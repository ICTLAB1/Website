# Caddy obtains and renews the TLS certificate on its own, from Let's Encrypt,
# the first time a request arrives. Nothing to install, nothing to renew by
# hand — but it does mean DNS must already point here, and ports 80 and 443
# must be reachable, before the first certificate can be issued.
#
# Three settings, because they answer three different questions:
#
#   SITE_ADDRESS        every name to serve, comma separated. A certificate is
#                       obtained for each, so every one needs a DNS record.
#   SITE_DOMAIN         the single canonical name — the one in search results,
#                       in every link, and in the sitemap.
#   SITE_REDIRECT_FROM  the other name, which permanently redirects to the
#                       canonical one.
#
# The direction is configuration rather than convention. Both `example.com` and
# `www.example.com` are legitimate choices for the canonical name, and which is
# right depends on where a site's existing search ranking sits; a deployment
# should not have to edit this file to pick one. Whichever is chosen, the other
# name is still served — it has to be, because a name cannot redirect anywhere
# without a certificate of its own.
#
# Deliberately thin. The application sets its own Content-Security-Policy with
# a per-request nonce, HSTS, X-Frame-Options and the rest, so adding them here
# would either duplicate them or, worse, override the nonce-bearing CSP with a
# weaker static one.

{
	email {$TLS_EMAIL}
	# Uncomment while testing to use Let's Encrypt's staging service, which has
	# far higher rate limits and issues untrusted certificates. Getting this
	# wrong five times against the real service locks the domain out for a week.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Everything on one canonical host, so a page is never reachable at two URLs
	# and the canonical tags stay honest.
	#
	# While testing on a subdomain there is no second name: SITE_REDIRECT_FROM is
	# set to the canonical name itself, and this matcher then only ever matches
	# requests that are already canonical, where the redirect is skipped anyway.
	# That keeps the file valid without a conditional — an empty `host` matcher
	# would fail to parse and take the whole site down.
	@needs_canonical {
		host {$SITE_REDIRECT_FROM}
		not host {$SITE_DOMAIN}
	}
	redir @needs_canonical https://{$SITE_DOMAIN}{uri} permanent

	reverse_proxy app:3000 {
		# The app reads the client address from X-Forwarded-For for rate
		# limiting and audit logs. Caddy sets it from the real connection, and
		# because the app is not otherwise reachable, a client cannot forge it.
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 10
		}
		format json
	}
}
