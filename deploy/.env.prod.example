# Copy to deploy/.env and fill in. Never commit the filled-in copy.
#
# Every value marked REQUIRED has no default: the stack refuses to start
# without it rather than running on a placeholder.

# ---------------------------------------------------------------- the domain
# REQUIRED. The single canonical name, no scheme and no www. Everything else
# redirects here, and it is what the site calls itself.
SITE_DOMAIN="techzoidtechnologies.com"

# REQUIRED. Every name Caddy should serve, comma separated. A TLS certificate is
# obtained for each, so every one listed must already have a DNS record pointing
# here — a name that does not resolve leaves Caddy retrying for it forever.
#
# On the real domain this is both names: the bare one, and www so that it has a
# certificate of its own to redirect from. Omitting www is the single most
# common way to go live half-broken — visitors who type it get a certificate
# warning, and nothing in the logs looks wrong.
#
# While testing on a subdomain, this is that subdomain alone. Do NOT add
# www.new.techzoidtechnologies.com; no such record exists and Caddy would chase
# a certificate for it forever.
#
#   testing:  SITE_ADDRESS="new.techzoidtechnologies.com"
#   live:     SITE_ADDRESS="techzoidtechnologies.com, www.techzoidtechnologies.com"
#
# deploy/preflight.sh checks this against SITE_DOMAIN before you move DNS.
SITE_ADDRESS="techzoidtechnologies.com, www.techzoidtechnologies.com"

# REQUIRED. Where Let's Encrypt sends certificate expiry warnings if renewal
# ever fails. Use a monitored mailbox, not a personal one.
TLS_EMAIL=""

# REQUIRED. Must match SITE_DOMAIN exactly, with https. Canonical URLs, the
# sitemap, Open Graph tags and the cookie and redirect safety checks read it,
# so a mismatch here shows up as subtly wrong links rather than as an error.
APP_URL="https://techzoidtechnologies.com"

# -------------------------------------------------------------- the database
# REQUIRED. Only the app talks to Postgres, over the internal network, so this
# password never crosses the public internet — but generate a real one anyway:
#   openssl rand -hex 24
#
# Hex, not base64, and not a password you invent. This value is substituted into
# a connection URL, so a `/`, `@`, `:`, `#` or `?` in it silently breaks that URL
# — the app then fails to reach its own database with an error that points
# nowhere near the cause. Hex has none of those characters.
POSTGRES_USER="techzoid"
POSTGRES_PASSWORD=""
POSTGRES_DB="techzoid"

# ----------------------------------------------------------------- the keys
# REQUIRED. Derives the keys that sign sessions and password-reset tokens.
#   openssl rand -base64 48
# Changing it later signs everyone out and voids outstanding reset links, which
# is the intended behaviour if it is ever exposed.
AUTH_SECRET=""

# REQUIRED. The first administrator, created once when the database is empty.
# Do not reuse the values from the repository's example file — they are public.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ------------------------------------------------------- business identity
# Only the first three are read from here for good.
#
# Everything below them — contact details, address, GSTIN, CIN, support hours
# and the grievance officer — is editable at /admin/settings, and what you set
# there wins. These stay as the starting values: they are what a fresh install
# shows before anyone logs in, and what a field falls back to if it is later
# cleared in the panel. Editing them here also still works; it just needs a
# redeploy, where the panel does not.
#
# Unset values are omitted from the site rather than filled with placeholders,
# and the admin dashboard lists what is still missing.
#
# The name and tagline are not editable in the panel. They are read when each
# page's metadata is built, before anything can be loaded from the database.
COMPANY_TRADING_NAME="TechZoid"
COMPANY_LEGAL_NAME="TechZoid Technologies Private Limited"
COMPANY_TAGLINE="Licenses . Solutions . Trust"
COMPANY_EMAIL_SALES="sales@techzoidtechnologies.com"
COMPANY_EMAIL_SUPPORT=""
COMPANY_EMAIL_ENTERPRISE=""
COMPANY_PHONE_SALES=""
COMPANY_PHONE_SUPPORT=""
COMPANY_ADDRESS_LINE1="407, 4th Floor, Pearl Business Park"
COMPANY_ADDRESS_LINE2="Netaji Subhash Place, Pitampura"
COMPANY_CITY="New Delhi"
COMPANY_STATE="Delhi"
COMPANY_POSTCODE="110034"
COMPANY_COUNTRY="India"
COMPANY_GSTIN="07AAICT5606J1Z4"
COMPANY_CIN=""
COMPANY_SUPPORT_HOURS=""

# Legally required of an online seller in India before launch: a named officer
# with contact details, per the Consumer Protection (E-Commerce) Rules 2020.
# Easier to set at /admin/settings, where it takes effect without a redeploy.
COMPANY_GRIEVANCE_OFFICER_NAME=""
COMPANY_GRIEVANCE_OFFICER_EMAIL=""
COMPANY_GRIEVANCE_OFFICER_PHONE=""

# ------------------------------------------------------------------- email
# Without SMTP_HOST, quotations and order confirmations are written to the
# container log instead of being sent. Nothing fails silently, but nothing
# reaches a customer either — so this is effectively required at launch.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
SALES_NOTIFICATION_EMAIL=""

# -------------------------------------------------------------------- bank
# Server-only. Never rendered on a public page or returned by an API — these
# reach the order confirmation email and nothing else.
COMPANY_BANK_NAME=""
COMPANY_BANK_ACCOUNT_NAME=""
COMPANY_BANK_ACCOUNT_NUMBER=""
COMPANY_BANK_IFSC=""
COMPANY_BANK_ACCOUNT_TYPE=""
COMPANY_BANK_BRANCH=""
COMPANY_UPI_ID=""
