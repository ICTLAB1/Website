# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ictlab?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Canonical, absolute, publicly reachable origin. Used for canonical URLs,
# sitemap entries, Open Graph URLs and cookie/redirect safety checks.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ byte random string. Generate with: openssl rand -base64 48
# Used to derive HMAC keys for session and password-reset token hashing.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Outbound email (optional in development - falls back to a console transport)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Internal address that receives enquiry / contact notifications
SALES_NOTIFICATION_EMAIL=""

# ---------------------------------------------------------------------------
# Business identity  ***REVIEW REQUIRED BEFORE PRODUCTION***
# Every value below is a placeholder. Replace with the operating company's real
# registered details. Nothing here is invented business data - blank values are
# rendered as an explicit "not configured" state rather than fake information.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME=""
COMPANY_TRADING_NAME=""
COMPANY_TAGLINE=""
COMPANY_EMAIL_SALES=""
COMPANY_EMAIL_SUPPORT=""
COMPANY_EMAIL_ENTERPRISE=""
COMPANY_PHONE_SALES=""
COMPANY_PHONE_SUPPORT=""
COMPANY_ADDRESS_LINE1=""
COMPANY_ADDRESS_LINE2=""
COMPANY_CITY=""
COMPANY_STATE=""
COMPANY_POSTCODE=""
COMPANY_COUNTRY="India"
COMPANY_GSTIN=""
COMPANY_CIN=""
COMPANY_SUPPORT_HOURS=""

# ---------------------------------------------------------------------------
# Seed bootstrap (development only - the seed refuses to run when NODE_ENV=production
# unless SEED_ALLOW_PRODUCTION=true, and never seeds a default admin password)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
