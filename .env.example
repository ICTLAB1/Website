# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ictlab?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Canonical, absolute, publicly reachable origin. Used for canonical URLs,
# sitemap entries, Open Graph URLs and cookie/redirect safety checks.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ byte random string. Generate with: openssl rand -base64 48
# Used to derive HMAC keys for session and password-reset token hashing.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Outbound email (optional in development - falls back to a console transport)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Internal address that receives enquiry / contact notifications
SALES_NOTIFICATION_EMAIL=""

# ---------------------------------------------------------------------------
# Business identity  ***REVIEW REQUIRED BEFORE PRODUCTION***
# Every value below is a placeholder. Replace with the operating company's real
# registered details. Nothing here is invented business data - blank values are
# rendered as an explicit "not configured" state rather than fake information.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME=""
COMPANY_TRADING_NAME=""
COMPANY_TAGLINE=""
COMPANY_EMAIL_SALES=""
COMPANY_EMAIL_SUPPORT=""
COMPANY_EMAIL_ENTERPRISE=""
COMPANY_PHONE_SALES=""
COMPANY_PHONE_SUPPORT=""
# The registered office, as it appears on the certificate of incorporation.
# Rendered on the about page, in the footer, and in the legal documents, which
# are required to name it.
COMPANY_ADDRESS_LINE1=""
COMPANY_ADDRESS_LINE2=""
COMPANY_CITY=""
COMPANY_STATE=""
COMPANY_POSTCODE=""
COMPANY_COUNTRY="India"
COMPANY_GSTIN=""
COMPANY_CIN=""
COMPANY_SUPPORT_HOURS=""

# Grievance officer. The Consumer Protection (E-Commerce) Rules 2020 require an
# online seller to publish a named officer with contact details, to acknowledge
# a complaint within 48 hours and resolve it within one month. The legal pages
# state those commitments; this is who they name.
COMPANY_GRIEVANCE_OFFICER_NAME=""
COMPANY_GRIEVANCE_OFFICER_EMAIL=""
COMPANY_GRIEVANCE_OFFICER_PHONE=""

# ---------------------------------------------------------------------------
# Bank transfer details (optional)
# Server-only. Never rendered on any public page or API response - read only
# by the order confirmation email, as payment-against-invoice instructions for
# the customer who placed that specific order. Leave unset to omit that section
# from the email entirely rather than sending a partially-filled instruction.
# ---------------------------------------------------------------------------
COMPANY_BANK_NAME=""
COMPANY_BANK_ACCOUNT_NAME=""
COMPANY_BANK_ACCOUNT_NUMBER=""
COMPANY_BANK_IFSC=""
COMPANY_BANK_ACCOUNT_TYPE=""
COMPANY_BANK_BRANCH=""
COMPANY_UPI_ID=""

# ---------------------------------------------------------------------------
# Seed bootstrap (development only - the seed refuses to run when NODE_ENV=production
# unless SEED_ALLOW_PRODUCTION=true, and never seeds a default admin password)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
