{
  "name": "ictlab-enterprise-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "content:migrate": "tsx prisma/content-migrate.ts",
    "content:status": "tsx prisma/content-migrate.ts --status",
    "db:reset": "prisma migrate reset --force",
    "verify:responsive": "node scripts/verify/responsive.mjs",
    "verify:a11y": "node scripts/verify/accessibility.mjs",
    "verify:interactions": "node scripts/verify/interactions.mjs",
    "verify": "npm run verify:responsive && npm run verify:a11y && npm run verify:motion && npm run verify:interactions && npm run verify:faq && npm run verify:lifecycle && npm run verify:admin && npm run verify:cms && npm run verify:page-editor && npm run verify:navigation && npm run verify:uploads && npm run verify:hardware && npm run verify:requirements && npm run verify:quote-revisions && npm run verify:organisations && npm run verify:partners && npm run verify:users && npm run verify:settings && npm run verify:payment-settings && npm run verify:payments && npm run verify:authz && npm run verify:attack && npm run verify:acceptance && npm run verify:crawl && npm run verify:seo",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:lifecycle": "node scripts/verify/lifecycle.mjs",
    "verify:attack": "bash scripts/verify/attack.sh",
    "verify:admin": "node scripts/verify/admin-crud.mjs",
    "verify:motion": "node scripts/verify/motion.mjs",
    "verify:cms": "tsx scripts/verify/cms.ts",
    "content:export": "tsx scripts/export-content-seed.ts",
    "verify:page-editor": "node scripts/verify/page-editor.mjs",
    "verify:navigation": "node scripts/verify/navigation-editor.mjs",
    "verify:authz": "node scripts/verify/authz.mjs",
    "verify:acceptance": "node scripts/verify/acceptance.mjs",
    "verify:faq": "node scripts/verify/faq.mjs",
    "verify:crawl": "node scripts/verify/crawl.mjs",
    "verify:seo": "node scripts/verify/seo.mjs",
    "verify:settings": "node scripts/verify/settings-editor.mjs",
    "verify:build": "bash scripts/verify/build-without-database.sh",
    "verify:payments": "node scripts/verify/payments.mjs",
    "verify:payment-settings": "node scripts/verify/payment-settings.mjs",
    "verify:users": "node scripts/verify/users-and-deletion.mjs",
    "verify:uploads": "node scripts/verify/uploads.mjs",
    "verify:hardware": "node scripts/verify/hardware.mjs",
    "verify:organisations": "node scripts/verify/organisations.mjs",
    "verify:partners": "node scripts/verify/partners.mjs",
    "verify:requirements": "node scripts/verify/requirements.mjs",
    "verify:quote-revisions": "node scripts/verify/quote-revisions.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.1",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "eslint": "9.18.0",
    "eslint-config-next": "^16.3.1",
    "playwright": "^1.62.1",
    "postcss": "8.5.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9",
    "vitest": "^4.1.11"
  }
}
