model Renewal {
  id          String        @id @default(cuid())
  reference   String        @unique
  licenceId   String
  licence     Licence       @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  status      RenewalStatus @default(UPCOMING)
  dueAt       DateTime
  seats       Int           @default(1)
  quotedMinor Int?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([licenceId])
  @@index([dueAt])
  @@index([status])
}

/// A file belonging to a customer organisation.
///
/// Never served from `public/`. Business documents are quotations, purchase
/// orders and invoices: putting them on a path anybody could guess would make
/// every one of them readable by anybody who guessed it, which is the failure
/// this model exists to make impossible. They are fetched through a route that
/// resolves the organisation first — see `app/documents/[reference]`.
///
/// The bytes live outside the database, named after a digest of their own
/// contents, so no part of a filename anybody supplied ever reaches the
/// filesystem.
model Document {
  id        String       @id @default(cuid())
  reference String       @unique
  kind      DocumentKind

  /// What the person called it. Shown, and used for the download name — never
  /// used to find the file.
  filename  String
  /// The type detected from the bytes, never the one the upload claimed.
  mimeType  String
  bytes     Int
  /// Where it is on disk: a digest of the contents plus an extension.
  storageKey String
  /// SHA-256 of the contents in full, for integrity and de-duplication.
  digest    String

  /// Who it belongs to. The organisation is the unit of access, as everywhere.
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Who put it there — a customer, or a member of staff acting for them.
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// What it is about. All optional: a document may be attached to any of
  /// these, or to none while it is being sorted out.
  enquiryId String?
  enquiry   Enquiry?     @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  quoteId   String?
  quote     Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ticketId  String?
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  /// Set when staff have checked it. Meaningful for a purchase order, which
  /// must not confirm an order on the strength of an upload alone.
  verifiedAt DateTime?
  note       String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([enquiryId])
  @@index([quoteId])
  @@index([orderId])
  @@index([ticketId])
  @@index([kind])
}

model SupportTicket {
  id        String         @id @default(cuid())
  reference String         @unique
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Set from the raiser's company, so a colleague can pick up a ticket the
  /// person who raised it is not around to answer.
  companyId String?
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  subject   String
  category  String
  message   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  documents Document[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

// ------------------------------ content ------------------------------------

model Service {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  category     String
  summary      String
  heroHeadline String
  problem      String
  solution     String
  benefits     String[]
  process      Json
  technologies String[]
  displayOrder Int       @default(100)
  featured     Boolean   @default(false)
  published    Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  faqs Faq[]

  @@index([category])
  @@index([published, deletedAt])
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  body        String
  category    String
  tags        String[]
  status      PostStatus @default(DRAFT)
  readMinutes Int        @default(5)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  // Groups FAQs for a page that is not backed by a database row, e.g. the
  // "microsoft-licensing" landing page.
  topic        String?
  displayOrder Int      @default(100)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId      String?
  brand        Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
  @@index([brandId])
  @@index([serviceId])
  @@index([topic])
  // FAQs grow with the catalogue rather than with editorial effort, so their
  // search paths get the same trigram treatment as products.
  @@index([question(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([answer(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ------------------------------ operations ---------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  // Never store credentials, tokens or raw request bodies here.
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Site-wide notices shown above the header.
///
/// Scheduling is expressed as an optional window rather than a single flag so a
/// promotion can be prepared in advance and expire on its own, without anyone
/// remembering to switch it off.
/// An independently issued certification held by this company.
///
/// Structured rather than written into page copy, for one reason: certificates
/// expire. A claim of ISO 27001 compliance sitting in a paragraph of marketing
/// text stays on the page for years after the certificate lapses, and nobody
/// notices because nothing in the system knows it was a dated fact. Here the
/// expiry is a column, the renderer checks it, and a lapsed certificate stops
/// being displayed on its own.
///
/// Every field is transcribed from the certificate itself, including the number
/// and the body that issued it, so a visitor can verify the claim rather than
/// take it on trust. Nothing here may be filled in from memory or inference.
model Certification {
  id String @id @default(cuid())

  /// The standard, exactly as written on the certificate: "ISO 9001:2015".
  standard String
  /// What the standard covers: "Quality Management System".
  title     String
  /// The certificate's own reference number.
  reference String
  /// The certification body that issued it.
  issuer String
  /// Where a visitor can check it is still valid.
  verifyUrl String?
  /// The scope the certificate was granted for, as printed on it.
  scope String?

  issuedAt  DateTime
  /// Past this date the certificate is not displayed. Null means no expiry
  /// is printed on it, which is unusual and worth checking before trusting.
  expiresAt DateTime?

  displayOrder Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([standard, reference])
  @@index([displayOrder])
  @@index([expiresAt])
}

model Banner {
  id           String     @id @default(cuid())
  name         String
  message      String
  href         String?
  linkLabel    String?
  tone         BannerTone @default(INFO)
  startsAt     DateTime?
  endsAt       DateTime?
  active       Boolean    @default(false)
  displayOrder Int        @default(100)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([active, startsAt, endsAt])
}

/// A CMS-managed marketing page.
///
/// The slug is the full path below the site root, so "microsoft-365/business-standard"
/// is one row rather than a nested hierarchy. An empty slug is reserved for the
/// home page, which is a Page like any other so there is only one content system
/// to maintain.
model Page {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  keywords    String[]
  status      PageStatus @default(DRAFT)
  /// Trail of { label, href? }, validated on read and write.
  breadcrumb  Json       @default("[]")
  /// Optional joins that let blocks pull live rows without duplicating them.
  brandId     String?
  brand       Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  faqTopic    String?
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sections PageSection[]

  @@index([status, deletedAt])
  @@index([brandId])
}

/// One ordered block on a page.
///
/// `data` holds the block's payload, validated by a zod schema selected on
/// `type` at both write and read. Fifteen sets of nullable typed columns would
/// be far worse to maintain, and a bad or legacy row degrades to a skipped
/// block rather than a failed page.
model PageSection {
  id           String          @id @default(cuid())
  pageId       String
  page         Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type         PageSectionType
  displayOrder Int             @default(100)
  visible      Boolean         @default(true)
  data         Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([pageId, displayOrder])
}

/// Header, footer and utility navigation.
///
/// Exactly two levels in practice: a top-level item, then either a flat list of
/// links or a set of columns. `href` is free-form because many links are
/// catalogue filters such as /products?brand=microsoft rather than routes.
model NavigationItem {
  id           String           @id @default(cuid())
  menu         NavigationMenu
  label        String
  href         String?
  description  String?
  parentId     String?
  parent       NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[] @relation("NavTree")
  displayOrder Int              @default(100)
  visible      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([menu, parentId, displayOrder])
}

/// The company's public-facing business identity, editable in the admin panel.
///
/// Exactly one row, whose id is always `singleton` — the values describe *this*
/// company, so a second row would be meaningless. `upsert` on that fixed id is
/// what creates it, which means a fresh install needs no seed for it.
///
/// Everything here was previously environment configuration and is here now
/// because it changes without the code changing: a phone number, an office
/// move, a newly appointed grievance officer. Editing those should not require
/// a rebuild and a redeploy.
///
/// Two categories deliberately did *not* move.
///
/// The trading name, legal name and tagline stay in the environment because
/// they are read at module scope by `buildMetadata`, in 46 route files, where
/// nothing can be awaited — and because renaming a company is a rebrand, not a
/// Tuesday afternoon edit.
///
/// Bank details stay in the environment because they are payment credentials.
/// They reach one outbound order email and are never read by a page, so putting
/// them behind a login that an administrator account could reach would widen
/// their exposure for no gain in convenience.
///
/// Every column is nullable, and a null falls back to its environment variable.
/// That is what lets an already-running deployment upgrade without losing a
/// single value: until someone edits a field in the panel, the environment
/// still supplies it.
model SiteSettings {
  id String @id @default("singleton")

  emailSales      String?
  emailSupport    String?
  emailEnterprise String?
  phoneSales      String?
  phoneSupport    String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postcode     String?
  country      String?

  gstin        String?
  cin          String?
  supportHours String?

  /// What one US dollar / UAE dirham is worth, in paise.
  ///
  /// Set by an administrator and never guessed. There is no default and no
  /// live feed: a rate this site invented would be a price this business did
  /// not agree to, and a feed that failed would either freeze at a stale
  /// number or take the catalogue down. A currency with no rate is simply not
  /// offered, so the switcher shows only what has been priced deliberately.
  ///
  /// Paise rather than a decimal for the same reason as every other money
  /// value here: integers, and no floating point anywhere near a price.
  /// 1 USD at ₹83.50 is stored as 8350.
  usdRatePaise Int?
  aedRatePaise Int?

  /// The terms printed at the foot of every quotation email.
  ///
  /// Deliberately empty by default and never seeded with sample wording.
  /// Payment terms, validity, delivery timelines and a liability position are
  /// commercial and legal commitments this business makes to its customers;
  /// inventing plausible-looking ones and mailing them out would be worse than
  /// sending none. Until it is set, quotations link to the published terms page
  /// instead. Markdown; one point per line.
  quoteTerms String?

  /// Publishing a named grievance officer and their contact details is required
  /// of an online seller in India by the Consumer Protection (E-Commerce) Rules
  /// 2020. It is a statutory appointment rather than marketing copy, which is
  /// why it lives here and not in a content block anyone could edit.
  grievanceName  String?
  grievanceEmail String?
  grievancePhone String?

  updatedAt DateTime @updatedAt
  /// The administrator who last saved. Nullable so a row written by a migration
  /// or a restore does not have to invent an author.
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Which payment gateway is configured, and its credentials.
///
/// One row, id `singleton`, like `SiteSettings` — and separate from it on
/// purpose. This holds credentials that can move money; that holds a telephone
/// number and an office address. Keeping them apart means the payment
/// credentials are not read on every page render, and a mistake in the
/// business-identity form cannot touch them.
///
/// The two secrets are encrypted at rest by `lib/secret-box.ts` and are never
/// sent back to a browser. The key id is not a secret — Razorpay Checkout needs
/// it in the page — so it is stored and displayed in the clear.
model PaymentSettings {
  id String @id @default("singleton")

  /// Off by default. Turning it on with no keys does nothing: the payment
  /// option only appears when the gateway is both enabled and configured.
  enabled Boolean @default(false)

  /// TEST or LIVE. Stored rather than inferred from the key prefix, so that
  /// pointing at live keys is a deliberate act with its own audit entry.
  mode PaymentMode @default(TEST)

  razorpayKeyId           String?
  /// AES-256-GCM, keyed from AUTH_SECRET. Never rendered.
  razorpayKeySecret       String?
  /// Also encrypted. Used to authenticate Razorpay's webhook calls, which is
  /// the only trustworthy signal that a payment was actually captured.
  razorpayWebhookSecret   String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

enum PaymentMode {
  TEST
  LIVE
}

/// The outbound mail server.
///
/// Held here rather than only in environment configuration for the same reason
/// as the business identity: changing which mailbox sends the site's email is
/// an ordinary administrative act, and it should not require SSH access and a
/// redeploy. Every field falls back to its environment variable when unset, so
/// a deployment already configured through `.env` keeps working untouched until
/// somebody edits it here.
///
/// The password is encrypted at rest by `lib/secret-box.ts` and is never sent
/// back to a browser.
/// How outbound mail leaves this system.
enum MailProvider {
  /// A mail server on port 587 or 465, with a username and password.
  SMTP
  /// Microsoft Graph, over HTTPS. No password, no SMTP AUTH, and unaffected by
  /// a hosting provider blocking outbound mail ports — which most of them do.
  MICROSOFT_GRAPH
}

model MailSettings {
  id String @id @default("singleton")

  provider MailProvider @default(SMTP)

  /// Microsoft Entra application registration, used with the client-credentials
  /// flow: the site authenticates as itself rather than as a person, so there
  /// is no sign-in to keep alive and no refresh token to expire. Needs the
  /// Mail.Send *application* permission with tenant admin consent.
  graphTenantId     String?
  graphClientId     String?
  /// AES-256-GCM, keyed from AUTH_SECRET. Never rendered.
  graphClientSecret String?
  /// The mailbox to send as. The application permission grants access to every
  /// mailbox in the tenant, so this is the one place that decides which — worth
  /// restricting in Entra with an application access policy as well.
  graphSender       String?

  host String?
  port Int?
  /// Implicit TLS on connect (port 465). Most providers use STARTTLS on 587,
  /// where this is false.
  secure Boolean?

  username String?
  /// AES-256-GCM, keyed from AUTH_SECRET. Never rendered.
  password String?

  /// The From address. Providers generally require it to be the mailbox being
  /// signed in as, or a confirmed alias of it.
  fromAddress String?
  fromName    String?

  /// Where a copy of each new enquiry and order is sent internally.
  salesNotificationEmail String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// One attempt to pay for an order through the gateway.
///
/// A row per attempt rather than a status column on the order, because
/// abandoned and failed attempts are ordinary — a customer closes the tab, a
/// bank declines, they try again with a different card — and each one is a fact
/// worth keeping when somebody later asks why an order was not paid.
///
/// The money is recorded here, never on the request that reported it. Every
/// amount is copied from the order at the moment the attempt is created, and
/// what the gateway later says it captured is checked against it.
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider String @default("razorpay")

  /// The gateway's order id. Unique because it is what the browser callback and
  /// the webhook both use to find this row, and two rows sharing one would make
  /// that lookup ambiguous at exactly the wrong moment.
  providerOrderId String @unique

  /// The gateway's payment id, known only once a payment is attempted. Unique
  /// so that a webhook and a browser callback reporting the same capture cannot
  /// produce two captured rows.
  providerPaymentId String? @unique

  status      PaymentStatus @default(CREATED)
  amountMinor Int
  currency    String        @default("INR")

  /// Which set of keys took this payment. A test payment must never be
  /// mistaken for money, and the mode can be switched between one attempt and
  /// the next, so it is recorded per attempt rather than read back from
  /// settings.
  mode PaymentMode

  /// As reported by the gateway: card, upi, netbanking, wallet. Informational.
  method        String?
  failureReason String?

  /// Set once, when the capture is first recorded. Its presence is what makes
  /// replaying a webhook a no-op.
  capturedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

enum PaymentStatus {
  /// Gateway order created; the customer has not been charged.
  CREATED
  /// Money taken and confirmed.
  CAPTURED
  /// The gateway reported a failure, or the customer gave up.
  FAILED
  /// Returned to the customer after capture.
  REFUNDED
}

/// A content change that has been applied to this database.
///
/// The schema has `prisma migrate` for structure; this is the equivalent for
/// the rows structure holds. It exists because of one true and easily missed
/// fact: **the container seeds only a database with no pages.** That guard is
/// right — a redeploy must never overwrite copy someone edited in the admin
/// panel — and its consequence is that a release which changes seeded content
/// arrives at a live site as new code and old rows. Nothing is broken, nothing
/// logs an error, and the site simply keeps showing what it showed yesterday.
///
/// So a change to seeded content is written twice: into the seed, for databases
/// that do not exist yet, and as a content migration, for the one that is
/// already serving. Each is applied at most once and recorded here, which is
/// what lets an administrator's later edits stand: the migration that set a
/// section has already run, and will not run again to undo them.
model ContentMigration {
  /// The migration's own name, e.g. `2026-08-homepage-sections`. Chosen by
  /// hand rather than generated, because it has to be readable in a log that
  /// somebody reads while wondering why a deploy did or did not change a page.
  id String @id

  /// What it did, in the words it printed at the time. Kept so the question
  /// "did this deploy apply the homepage change?" has an answer in the
  /// database rather than in a scrollback buffer that is long gone.
  summary String

  appliedAt DateTime @default(now())
}
