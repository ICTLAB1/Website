// ---------------------------------------------------------------------------
// Enterprise technology marketplace - relational schema
//
// Conventions
//   * Monetary values are integers in the currency's minor unit (paise for INR).
//     Floating point is never used for money.
//   * Public-facing records expose a human `reference` (ENQ-2026-4F2A9C) rather
//     than their primary key, so internal identifiers are never enumerable.
//   * Content-bearing entities use `deletedAt` soft deletion so that historical
//     enquiries / orders keep referential integrity after an archive.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------ enums --------------------------------------

/// What somebody may do inside TechZoid.
///
/// The first three are the roles this application shipped with and are left
/// exactly where they were, so no stored row changes meaning. The rest are the
/// operating roles the business actually has; each one is a job, not a rank,
/// and what it may do is declared once in `lib/auth/capabilities`.
enum UserRole {
  CUSTOMER
  SALES
  ADMIN
  DIRECTOR
  SALES_MANAGER
  PROCUREMENT
  OPERATIONS
  ACCOUNTS
  SUPPORT
}

/// What somebody may do inside their own organisation.
///
/// Orthogonal to `UserRole`: a customer's finance controller and a customer's
/// IT administrator are both `CUSTOMER` to us and differ only here. Read access
/// is the organisation's records for every role — colleagues covering for each
/// other is the entire point of an organisation account — and the role decides
/// what may be written.
enum CompanyRole {
  /// Full access, including the company profile and its people.
  ADMIN
  /// Requirements, enquiries, quotations and orders.
  PROCUREMENT
  /// Invoices and payments.
  FINANCE
  /// Licences, devices and support.
  IT
  /// Read-only.
  VIEWER
}

enum AddressKind {
  BILLING
  DELIVERY
  BOTH
}

enum ContactKind {
  PROCUREMENT
  FINANCE
  IT
  ESCALATION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The shape of a hardware product, where it has one.
///
/// Null for software, which is most of the catalogue. This is the field the
/// hardware catalogue filters and groups on: "laptops" and "desktops" are
/// derived from it rather than stored separately, because a product that is
/// both would be a data-entry mistake and this makes it unrepresentable.
///
/// Workstations are their own members rather than a flag beside the others. A
/// mobile workstation is bought for different reasons than a laptop, by people
/// who search for the word, and collapsing the two would hide it.
enum FormFactor {
  LAPTOP
  MOBILE_WORKSTATION
  DESKTOP_TOWER
  DESKTOP_SFF
  DESKTOP_MINI
  DESKTOP_WORKSTATION
  ALL_IN_ONE
  /// A server in a tower case, for an office rather than a rack.
  TOWER_SERVER
  /// A rack-mounted server. How many units it occupies is a specification, not
  /// a form factor — a 1U and a 2U are bought by the same person for the same
  /// rack, and splitting them would put half the range behind a second filter.
  RACK_SERVER
}

enum Availability {
  IN_STOCK
  MADE_TO_ORDER
  ON_REQUEST
  DISCONTINUED
}

/// Where a brand sits in what this business sells.
///
/// Used to group the brands page, because "authorised to resell licensing
/// from" is the wrong heading over a laptop manufacturer and the right one
/// over a software publisher. A classification of the company, not a claim
/// about the relationship with it — that is `partnerLabel`, and the two must
/// not be confused.
enum BrandSegment {
  /// Publishers whose product is a licence or a subscription.
  SOFTWARE_CLOUD
  /// Manufacturers of commercial laptops, desktops and workstations.
  BUSINESS_HARDWARE
  /// Servers, storage, networking, virtualisation and the platforms under them.
  ENTERPRISE_INFRASTRUCTURE
  /// Endpoint, network and threat protection.
  CYBERSECURITY
}

enum PurchaseMode {
  DIRECT
  ENQUIRY
  BOTH
}

/// Who a price is available to.
///
/// Publisher price lists carry the same SKU several times over at different
/// figures, because education and non-profit rates exist and are restricted to
/// organisations that qualify. Before this existed, importing such a list left
/// no way to tell those rows apart, and the cheapest one would have won every
/// "from" price on the catalogue — quoting an academic rate to a company.
enum VariantAudience {
  /// Available to any buyer. The default, and the only audience that may be
  /// bought without a person checking eligibility first.
  COMMERCIAL
  /// Academic pricing, for qualifying institutions only.
  EDUCATION
  /// Charity and non-profit pricing, for qualifying organisations only.
  NON_PROFIT
}

enum LicenceType {
  SUBSCRIPTION_ANNUAL
  SUBSCRIPTION_MONTHLY
  PERPETUAL
  VOLUME
  CSP
  OEM
  EDUCATION
  MAINTENANCE

  /// Not a licence at all: goods.
  ///
  /// A hardware model is a Product and its configurations are ProductVariants,
  /// the same shape licensing already uses — which means a configuration needs
  /// a value here. This is that value, and the interface treats it as the
  /// absence of a licence rather than as a kind of one: the product card and
  /// detail page show series and form factor where they would show licence and
  /// term, and the licence facet does not offer it.
  ///
  /// The alternative was making `licenceType` nullable, which touches
  /// twenty-odd call sites in the licensing paths this change must not disturb.
  HARDWARE
}

/// Where a requirement has got to.
///
/// The set a procurement officer can actually be told, rather than the four
/// internal buckets this started with. "Quotation preparing" and "needs
/// information" exist because they are the two states a customer most often
/// rings up to ask about, and a status that cannot express them sends them to
/// the phone.
enum EnquiryStatus {
  /// Started and not yet submitted. Nobody here has seen it.
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  /// We have asked the customer something and are waiting.
  NEEDS_INFORMATION
  QUOTATION_PREPARING
  QUOTATION_SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
  CLOSED
}

/// What a stored document is.
///
/// Not a free-text label: what a document *is* decides who may see it, whether
/// it may be replaced, and which screen it belongs on, so it is a closed set
/// rather than something typed at upload time.
enum DocumentKind {
  /// A bill of quantities or requirement list a customer uploaded.
  BOQ
  /// A customer's purchase order.
  PURCHASE_ORDER
  /// A quotation we generated.
  QUOTATION
  INVOICE
  DELIVERY_NOTE
  /// Licence certificates, keys and entitlement confirmations.
  LICENCE
  WARRANTY
  /// Something attached to a support ticket.
  SUPPORT_ATTACHMENT
  OTHER
}

/// How a requirement reached us.
enum EnquiryKind {
  /// Built in the enquiry basket from catalogue lines.
  BASKET
  /// Described in words and specifications, without naming products.
  REQUIREMENT
  /// Uploaded as a bill of quantities.
  BOQ
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  /// Replaced by a later version. Kept, never edited, never deleted.
  SUPERSEDED
}

/// Why somebody wrote on a quotation.
enum QuoteMessageKind {
  /// The customer asked something about it.
  QUESTION
  /// The customer wants it changed and said how.
  REVISION_REQUEST
  /// Somebody here answered.
  REPLY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROVISIONING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum LicenceStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum RenewalStatus {
  UPCOMING
  QUOTED
  RENEWED
  LAPSED
  DECLINED
}

/// Where a device is in its life.
enum DeviceStatus {
  /// In use by somebody.
  IN_SERVICE
  /// Held as a spare, or waiting to be issued.
  IN_STOCK
  /// Away being repaired.
  IN_REPAIR
  /// Withdrawn from use.
  RETIRED
  LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum NavigationMenu {
  HEADER
  FOOTER
  UTILITY
}

/// Block types a CMS page can be built from.
///
/// Derived from what the existing marketing pages actually use rather than
/// invented up front: prose and bullets carry most of the copy, card grids and
/// link lists carry most of the rest, and the collection blocks pull live rows
/// so a page can show products or articles without duplicating them.
enum PageSectionType {
  HERO
  RICH_TEXT
  BULLETS
  CARDS
  ICON_POINTS
  LINK_LIST
  KEY_VALUE_LIST
  CHIP_LIST
  SPLIT_PANEL
  STAT_BAR
  PRODUCT_GRID
  COLLECTION_GRID
  FAQ
  COMPANY_INFO
  NOTICE
  CTA_BANNER
  PLANS
}

enum BannerTone {
  INFO
  PROMO
  WARNING
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PurchaseTimeline {
  IMMEDIATE
  WITHIN_30_DAYS
  WITHIN_90_DAYS
  EXPLORING
}

// ------------------------------ identity -----------------------------------

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole    @default(CUSTOMER)
  /// Only meaningful when the account belongs to a company. An account with no
  /// company sees its own records and nobody else's, which is what a sole
  /// trader signing up on the website should get.
  companyRole   CompanyRole @default(VIEWER)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  // Counts consecutive failed sign-in attempts; cleared on success.
  failedLogins  Int         @default(0)
  lockedUntil   DateTime?
  companyId     String?
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /// Companies this member of staff looks after. Every lead, quotation, order,
  /// renewal and ticket for those companies has a name against it.
  accountsManaged Company[]  @relation("AccountManager")
  quotesOwned     Quote[]    @relation("QuoteOwner")
  dealsOwned      Deal[]     @relation("DealOwner")
  activities      Activity[] @relation("ActivityAuthor")

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  verifyTokens   EmailVerificationToken[]
  enquiries      Enquiry[]
  quotes         Quote[]
  orders         Order[]
  licences       Licence[]
  tickets        SupportTicket[]
  documents      Document[]
  auditLogs      AuditLog[]
  authoredPosts  BlogPost[]
  savedSettings  SiteSettings[]
  savedPayments  PaymentSettings[]
  savedMail      MailSettings[]
  savedCrm       CrmSettings[]            @relation("CrmSettingsEditor")
  quoteMessages  QuoteMessage[]
  ticketMessages TicketMessage[]
  devices        Device[]

  @@index([companyId])
  @@index([role])
}

/// A customer organisation.
///
/// The unit of access control on the customer side: records belong to a
/// company, not to the individual who happened to raise them, so a procurement
/// officer on leave does not take the quotation history with them.
///
/// The registered address stays on the row itself because there is exactly one
/// of it and it goes on the tax invoice. Delivery addresses are a list, because
/// an organisation ordering forty laptops routinely ships them to four sites.
model Company {
  id            String  @id @default(cuid())
  name          String
  /// PAN, where the customer supplies it. Kept beside the GSTIN because
  /// procurement departments are routinely asked for both.
  pan           String?
  gstin         String?
  website       String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postcode      String?
  country       String  @default("India")
  employeeCount Int?

  /// The member of staff who owns this relationship.
  accountManagerId String?
  accountManager   User?   @relation("AccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  enquiries  Enquiry[]
  quotes     Quote[]
  orders     Order[]
  licences   Licence[]
  tickets    SupportTicket[]
  addresses  CompanyAddress[]
  contacts   CompanyContact[]
  documents  Document[]
  devices    Device[]
  deals      Deal[]
  activities Activity[]

  @@index([name])
  @@index([gstin])
  @@index([accountManagerId])
}

/// A delivery or billing address belonging to a company.
///
/// Soft-deleted, because an address is referenced by orders that have already
/// shipped to it and a hard delete would rewrite where they went.
model CompanyAddress {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  kind      AddressKind @default(DELIVERY)
  attention String?
  line1     String
  line2     String?
  city      String
  state     String
  postcode  String
  country   String      @default("India")
  /// A GSTIN for this place of business, where it differs from the company's.
  gstin     String?
  /// Preferred address for its kind. Not a database constraint: enforced when
  /// written, because "exactly one default per kind" is a rule about a set.
  isDefault Boolean     @default(false)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([companyId])
}

/// A named contact at a company, by function rather than by login.
///
/// Separate from `User`: the person who signs the purchase order often has no
/// reason to hold an account on this site, and quotations still have to reach
/// them.
model CompanyContact {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      ContactKind
  name      String
  email     String
  phone     String?
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  activities Activity[]

  @@unique([companyId, kind, email])
  @@index([companyId])
}

model Session {
  id         String    @id @default(cuid())
  // SHA-256 of the opaque session token. The raw token only ever exists in the
  // HttpOnly cookie, so a database disclosure does not yield usable sessions.
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A single-use link proving the person registering can read the address.
///
/// Deliberately the same shape as `PasswordResetToken`: only the hash is
/// stored, so the database never holds a usable link; `usedAt` makes it
/// single-use; `expiresAt` bounds it. The two are separate tables rather than
/// one with a `purpose` column, because a bug that let a verification token
/// reset a password would be severe and this makes it unrepresentable.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The address the link was sent to. Checked on use, so a token issued before
  /// an address change cannot verify the new one.
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------ catalogue ----------------------------------

model Brand {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String?
  summary     String
  description String
  logoText    String
  /// Path to the publisher's own logo, served from `public/brands/`.
  ///
  /// Local only, and validated as such: an admin-entered value ends up in an
  /// `src` attribute, so anything that is not a path under /brands/ is refused
  /// rather than rendered. Null falls back to the styled wordmark, which is
  /// what every brand showed before this existed and what any brand without
  /// artwork on file still shows.
  logoUrl     String?
  accentColor String  @default("#1e3a8a")
  website     String?

  /// Which part of the offer this brand belongs to. Null groups it under
  /// "other", which is a prompt to classify it rather than a resting place.
  segment BrandSegment?

  /**
   * Partner status.
   * Four columns rather than one string, because "we are a partner" is a claim
   * a buyer may put to the manufacturer, and the difference between a claim
   * somebody typed and one somebody stands behind has to be visible in the
   * data. Nothing appears publicly unless it has been confirmed *and*
   * deliberately published: see `lib/brand-partner`, which is the only place
   * that decides.
   */

  /// The designation exactly as the programme words it, e.g. the tier name.
  /// Never composed from the brand name in code — that is how "HP Partner"
  /// becomes a statement HP never made.
  partnerLabel       String?
  /// Partner or programme identifier. Internal: a buyer verifies with the
  /// manufacturer, not with a number on our own website.
  partnerReference   String?
  /// When somebody here last confirmed the designation is current.
  partnerConfirmedAt DateTime?
  /// Whether to state it publicly. Off by default, including for a brand whose
  /// label has been filled in.
  partnerPublic      Boolean   @default(false)
  /// The programme badge, as the publisher issues it. A file under
  /// `public/badges/` — see the README there.
  ///
  /// Shown only when the designation itself may be shown, so it lapses on the
  /// same clock: a badge is evidence for a claim, and it must never outlive the
  /// claim it is evidence for.
  partnerBadgeUrl    String?

  displayOrder Int       @default(100)
  featured     Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products   Product[]
  categories Category[]
  faqs       Faq[]
  pages      Page[]

  @@index([featured])
  @@index([deletedAt])
}

model Category {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  summary      String?
  description  String?
  icon         String?
  displayOrder Int        @default(100)
  featured     Boolean    @default(false)
  // Self-relation models the category -> subcategory hierarchy without a
  // separate near-identical Subcategory table.
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  brandId      String?
  brand        Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products Product[]

  @@index([parentId])
  @@index([brandId])
  @@index([featured])
  @@index([deletedAt])
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String
  description      String
  brandId          String
  brand            Brand         @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  status           ProductStatus @default(ACTIVE)
  availability     Availability  @default(ON_REQUEST)
  purchaseMode     PurchaseMode  @default(BOTH)
  featured         Boolean       @default(false)
  popularity       Int           @default(0)

  // Structured licensing metadata rendered on the product detail page.
  // `features` doubles as the "business features" list on hardware — security,
  // manageability, durability — because it is the same thing under a different
  // heading and a second array would drift from the first.
  features       String[]
  compatibility  String[]
  keywords       String[]
  licensingNotes String?
  deliveryNotes  String?
  supportNotes   String?

  /// The HSN or SAC code this is taxed under, and what its quantity counts.
  ///
  /// Both belong on the catalogue rather than being typed onto every quotation:
  /// a product's classification does not change per deal, and re-entering it
  /// each time is how two quotations for the same licence end up under two
  /// different HSN codes. Copied onto the quotation line at drafting time, and
  /// from then on the line owns its copy.
  ///
  /// Null prints nothing. An HSN code this application guessed would be a tax
  /// classification the business never made.
  hsnCode   String?
  unitLabel String?

  // ── hardware ──────────────────────────────────────────────────────────────
  // All null for software. A hardware model is a Product and its configurations
  // are ProductVariants, which is the same shape licensing already uses.

  /// The manufacturer's own family: "EliteBook", "ThinkPad T", "TravelMate P".
  /// Filtered on and shown on the card, because it is how buyers in this market
  /// actually narrow a choice — nobody asks for "a laptop", they ask for a
  /// ThinkPad T or an EliteBook.
  series String?

  /// Laptop, tower, small form factor, all-in-one. See `FormFactor`.
  formFactor FormFactor?

  /// The manufacturer's part number for the model as listed. Folded into
  /// `searchText`, because it is what a procurement officer pastes from a
  /// tender document.
  partNumber String?

  /// The product photograph. A path under `/uploads/` (validated, digest-named)
  /// or `/products/` — see `lib/product-image.ts`, which is deliberately the
  /// same shape of check as brand logos get.
  ///
  /// Null renders a labelled placeholder, never a broken image and never
  /// another product's photograph.
  imageUrl String?

  /// The manufacturer's own page for this model.
  ///
  /// Kept because specifications change and a catalogue entry with no
  /// provenance cannot be re-checked — six months on, nobody can tell whether a
  /// figure came from the manufacturer or from somebody's memory. Internal: it
  /// is for whoever maintains the catalogue, not a link the site advertises.
  sourceUrl String?

  /// When the record was last reconciled against `sourceUrl`. Shown in the
  /// admin panel so a stale entry is visible as stale.
  sourceCheckedAt DateTime?

  specs   ProductSpec[]
  devices Device[]

  // Denormalised lowercase haystack (name + sku + brand + keywords) backing
  // catalogue search without a separate search service.
  searchText String @default("")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  variants     ProductVariant[]
  faqs         Faq[]
  enquiryItems EnquiryItem[]
  quoteItems   QuoteItem[]
  orderItems   OrderItem[]
  licences     Licence[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status, deletedAt])
  @@index([featured])
  @@index([popularity])
  @@index([series])
  @@index([formFactor])
  // Trigram index for `contains` search, which emits LIKE '%term%'. A leading
  // wildcard cannot use a B-tree, so without this every search scans the table.
  // Declared here as well as in the migration so a later `migrate dev` does not
  // read it as drift and drop it.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// One row of a product's specification table.
///
/// A table rather than a JSON column, for two reasons that matter here.
/// Specifications are edited one line at a time in the admin panel, and rows
/// are what a form can edit; and they are the part of a hardware listing most
/// likely to be wrong, so they need to be addressable — "fix the storage line
/// on this model" is a query, not a re-serialisation of a blob.
///
/// Labels are free text on purpose. Manufacturers do not agree on what to call
/// things, and forcing "Processor" onto a row the source calls "Platform" would
/// be the catalogue inventing a fact about the product.
model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// "Processor", "Display", "Memory", "Warranty".
  label String
  /// The value as the manufacturer states it, including any qualification —
  /// "Configuration dependent" is a legitimate value and often the honest one.
  value String

  displayOrder Int @default(0)

  @@unique([productId, label])
  @@index([productId, displayOrder])
}

model ProductVariant {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String          @unique
  name        String
  licenceType LicenceType
  /// Who may buy at this price. Only COMMERCIAL is shown to everyone and
  /// bought without a person checking eligibility; see `lib/catalogue/audience`.
  audience    VariantAudience @default(COMMERCIAL)
  // Term length in months; null for perpetual licences.
  termMonths  Int?
  // Seats included in a single unit of this SKU.
  seats       Int             @default(1)
  isDefault   Boolean         @default(false)

  // Current price, denormalised for catalogue queries. Historical changes live
  // in the Price table.
  currency       String @default("INR")
  listPriceMinor Int
  salePriceMinor Int?
  gstRatePercent Int    @default(18)

  // ── hardware configuration ────────────────────────────────────────────────
  // All null on software. A variant of a hardware product *is* a build: one
  // part number, one processor, one memory and storage fitting. Recording it
  // here rather than in a table of its own because it is one-to-one with the
  // variant — a second table would be the same row behind a join, and the
  // enquiry basket, quotations and orders all already hang off the variant.
  //
  // Free text, not parsed. A line card says "16GB DDR5 RAM" and "2 X 16GB DDR5
  // RAM" and those are different machines; normalising them into a number
  // would throw away the distinction the buyer is choosing between.

  /// The manufacturer's part number. Distinct from `sku`, which is this site's
  /// unique key and exists even when the source names no part number.
  partNumber       String?
  processor        String?
  memory           String?
  storage          String?
  graphics         String?
  operatingSystem  String?
  opticalDrive     String?
  powerSupply      String?
  warranty         String?
  /// Servers. A workstation has graphics where a server has a RAID controller
  /// and a management processor, and calling either by the other's name would
  /// put a PERC card under a "Graphics" heading.
  raidController   String?
  systemManagement String?
  /// "Made in India", "Modified" — qualifications the source attaches to a
  /// specific build, kept verbatim rather than folded into another field.
  configNote       String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  prices       Price[]
  enquiryItems EnquiryItem[]
  quoteItems   QuoteItem[]
  orderItems   OrderItem[]
  licences     Licence[]

  @@index([productId])
  @@index([licenceType])
  @@index([partNumber])
  // Every public read filters on this, so it carries the same weight as the
  // price indexes beside it.
  @@index([audience])
  @@index([salePriceMinor])
  @@index([listPriceMinor])
}

/// Append-only price history. A row is written every time an administrator
/// changes a variant's price, giving an auditable pricing trail.
model Price {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currency       String         @default("INR")
  listPriceMinor Int
  salePriceMinor Int?
  gstRatePercent Int            @default(18)
  effectiveFrom  DateTime       @default(now())
  changedById    String?
  note           String?

  @@index([variantId, effectiveFrom])
}

// ------------------------------ enquiry / quote / order ---------------------

model Enquiry {
  id        String        @id @default(cuid())
  reference String        @unique
  /// Submitted, not draft: an enquiry created by the basket or the API has
  /// already been sent by the time the row exists. Only the requirement builder
  /// creates a draft, and it sets it explicitly.
  status    EnquiryStatus @default(SUBMITTED)

  contactName  String
  contactEmail String
  contactPhone String
  companyName  String
  gstin        String?
  country      String           @default("India")
  city         String?
  userCount    Int?
  requirements String?
  timeline     PurchaseTimeline @default(EXPLORING)

  /// How this one arrived, which decides how it is read and shown.
  kind EnquiryKind @default(BASKET)

  /**
   * The structured requirement, for the ones described rather than picked.
   * JSON rather than twelve columns because it is a snapshot of a form: what a
   * customer was asked for laptops in August is not what they will be asked
   * next year, and a column per question turns every wording change into a
   * migration. Validated by a zod schema on the way in and on the way out, the
   * same as the CMS blocks, so a payload that does not fit costs one section
   * rather than the page.
   */
  requirement Json?

  /// When it stopped being a draft. Null while it still is one.
  submittedAt DateTime?

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items     EnquiryItem[]
  quotes    Quote[]
  documents Document[]
  deals     Deal[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([contactEmail])
}

model EnquiryItem {
  id        String          @id @default(cuid())
  enquiryId String
  enquiry   Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot of what was requested, so the enquiry stays readable after a
  // catalogue change.
  productName String
  sku         String
  quantity    Int
  note        String?

  @@index([enquiryId])
  @@index([productId])
}

model Quote {
  id        String      @id @default(cuid())
  reference String      @unique
  status    QuoteStatus @default(DRAFT)
  enquiryId String?
  enquiry   Enquiry?    @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// The deal this quotation belongs to, where the business is tracked as one.
  /// Optional: quotations predate the pipeline and a quotation raised straight
  /// off an enquiry need not have a deal behind it.
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  currency      String @default("INR")
  subtotalMinor Int    @default(0)
  discountMinor Int    @default(0)
  taxMinor      Int    @default(0)
  totalMinor    Int    @default(0)

  validUntil DateTime?
  notes      String?
  sentAt     DateTime?

  /// What the customer is being asked to agree to on payment, in words, as it
  /// is printed on the document. Free text rather than an enum because these
  /// are negotiated per deal and a fixed list would be wrong by the second one.
  paymentTerms String?

  /// The number printed on the document, from the configured series.
  ///
  /// Separate from `reference`, which stays the key and the URL. A reference is
  /// unguessable so that nobody can walk another organisation's quotations by
  /// incrementing a URL; a document number is sortable so that a purchasing
  /// office can file it. Those are different jobs and one string cannot do
  /// both.
  ///
  /// Shared by every version of one quotation — a revision keeps the number and
  /// increments `version` — so the constraint is on the pair.
  documentNo String?

  /// The customer's own reference for this requirement: their RFQ or tender
  /// number. Echoed back on the document, because that is what their
  /// procurement system files it against. Ours is not a substitute for theirs.
  customerReference String?

  /// Who at TechZoid is answerable for this quotation, printed on it so the
  /// customer knows whom to ring. Separate from whoever happened to click
  /// "draft": that is in the audit log, and it is not the same question.
  ownerId String?
  owner   User?   @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /**
   * Versions.
   * A revised quotation is a new row, never an edit. The old figures were sent
   * to somebody who may have acted on them, forwarded them to finance or
   * attached them to a purchase order, and a system that overwrites them cannot
   * answer the only question that matters afterwards: what did we actually
   * quote, and when.
   * Every version of one quotation shares a `rootId` — the id of version 1,
   * which carries its own — so the whole history is one query.
   */
  version      Int       @default(1)
  rootId       String?
  root         Quote?    @relation("QuoteVersions", fields: [rootId], references: [id], onDelete: SetNull)
  versions     Quote[]   @relation("QuoteVersions")
  /// Set when a later version replaced this one.
  supersededAt DateTime?
  /// What changed, in words, written by whoever revised it.
  revisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     QuoteItem[]
  orders    Order[]
  documents Document[]
  messages  QuoteMessage[]

  /// One document number per version, so a revision keeps the number it was
  /// issued under and the pair still identifies exactly one row.
  @@unique([documentNo, version])
  @@index([status])
  @@index([userId])
  @@index([enquiryId])
  @@index([documentNo])
}

/// A question or a revision request on a quotation, and the answer to it.
///
/// A thread rather than an email, so the conversation about a quotation lives
/// beside the quotation instead of in four inboxes — which is the difference
/// between "we never received that" and a record of what was asked and when.
model QuoteMessage {
  id        String           @id @default(cuid())
  quoteId   String
  quote     Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind      QuoteMessageKind
  body      String
  /// Who wrote it. Null where an account was deleted; the message stays.
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Which side wrote it, recorded at the time rather than derived later — a
  /// salesperson's role can change, and what they wrote cannot.
  fromStaff Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([quoteId])
}

model QuoteItem {
  id        String          @id @default(cuid())
  quoteId   String
  quote     Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName    String
  sku            String
  quantity       Int
  unitPriceMinor Int
  discountMinor  Int    @default(0)
  gstRatePercent Int    @default(18)
  lineTotalMinor Int

  /**
   * What the printed document needs beside the name, captured onto the line
   * rather than read back through the product.
   * Copied at drafting time and then owned by the quotation. A product renamed
   * or reclassified next March must not silently change what a quotation said
   * last October — the customer has a copy, and the two must not disagree.
   */
  /// A sentence of what it is: "Annual subscription, includes Exchange".
  description String?
  /// Whose product it is, as printed. Denormalised from the brand for the same
  /// reason as everything else here.
  brandName   String?
  /// The HSN or SAC code the tax is charged under.
  hsnCode     String?
  /// What the quantity counts: users, nodes, devices, a project.
  unitLabel   String?

  @@index([quoteId])
}

model Order {
  id        String      @id @default(cuid())
  reference String      @unique
  status    OrderStatus @default(PENDING)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// One order per quotation, enforced by the database rather than by an
  /// application check, so two concurrent acceptances cannot both succeed.
  /// Nullable because a direct purchase has no quotation, and Postgres permits
  /// many NULLs under a unique constraint.
  quoteId   String?     @unique
  quote     Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  currency      String @default("INR")
  subtotalMinor Int    @default(0)
  discountMinor Int    @default(0)
  taxMinor      Int    @default(0)
  totalMinor    Int    @default(0)

  poNumber       String?
  billingGstin   String?
  billingName    String
  billingEmail   String
  billingPhone   String?
  billingAddress String?
  internalNotes  String?

  /**
   * Delivery, for the orders that ship something.
   * All nullable and all supplied by a person. Nothing here is derived or
   * predicted: an expected date this site invented would be a promise nobody
   * made, and a tracking number it guessed would be worse.
   */
  courier        String?
  trackingNumber String?
  /// Where the courier's own tracking lives. Validated as an https URL.
  trackingUrl    String?
  dispatchedAt   DateTime?
  expectedAt     DateTime?
  deliveredAt    DateTime?
  deliveryNote   String?

  placedAt    DateTime  @default(now())
  fulfilledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items     OrderItem[]
  licences  Licence[]
  payments  Payment[]
  documents Document[]
  devices   Device[]

  @@index([status])
  @@index([userId])
  @@index([placedAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName    String
  sku            String
  quantity       Int
  unitPriceMinor Int
  discountMinor  Int    @default(0)
  gstRatePercent Int    @default(18)
  lineTotalMinor Int

  @@index([orderId])
}

// ------------------------------ post-sale ----------------------------------

model Licence {
  id        String          @id @default(cuid())
  reference String          @unique
  status    LicenceStatus   @default(ACTIVE)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  sku         String
  seats       Int       @default(1)
  startsAt    DateTime
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  renewals Renewal[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([expiresAt])
}

model Renewal {
  id          String        @id @default(cuid())
  reference   String        @unique
  licenceId   String
  licence     Licence       @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  status      RenewalStatus @default(UPCOMING)
  dueAt       DateTime
  seats       Int           @default(1)
  quotedMinor Int?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([licenceId])
  @@index([dueAt])
  @@index([status])
}

/// A file belonging to a customer organisation.
///
/// Never served from `public/`. Business documents are quotations, purchase
/// orders and invoices: putting them on a path anybody could guess would make
/// every one of them readable by anybody who guessed it, which is the failure
/// this model exists to make impossible. They are fetched through a route that
/// resolves the organisation first — see `app/documents/[reference]`.
///
/// The bytes live outside the database, named after a digest of their own
/// contents, so no part of a filename anybody supplied ever reaches the
/// filesystem.
model Document {
  id        String       @id @default(cuid())
  reference String       @unique
  kind      DocumentKind

  /// What the person called it. Shown, and used for the download name — never
  /// used to find the file.
  filename   String
  /// The type detected from the bytes, never the one the upload claimed.
  mimeType   String
  bytes      Int
  /// Where it is on disk: a digest of the contents plus an extension.
  storageKey String
  /// SHA-256 of the contents in full, for integrity and de-duplication.
  digest     String

  /// Who it belongs to. The organisation is the unit of access, as everywhere.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Who put it there — a customer, or a member of staff acting for them.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// What it is about. All optional: a document may be attached to any of
  /// these, or to none while it is being sorted out.
  enquiryId String?
  enquiry   Enquiry?       @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  quoteId   String?
  quote     Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ticketId  String?
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  /// Set when staff have checked it. Meaningful for a purchase order, which
  /// must not confirm an order on the strength of an upload alone.
  verifiedAt DateTime?
  note       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([enquiryId])
  @@index([quoteId])
  @@index([orderId])
  @@index([ticketId])
  @@index([kind])
}

/// A piece of hardware a customer owns.
///
/// The register a customer asks us for when the laptop on somebody's desk stops
/// working: what it is, when it was bought, whether it is still under warranty,
/// and who has it. Kept as its own model rather than derived from order lines,
/// because a device has a serial number and a person against it and an order
/// line has neither — one order line of forty laptops becomes forty devices.
///
/// Nothing here is inferred. A warranty date that nobody supplied stays null
/// and the interface says "not recorded" rather than assuming a year.
model Device {
  id        String   @id @default(cuid())
  reference String   @unique
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Who recorded it, so an account with no organisation still has a register.
  /// Every other customer record carries both columns and is read through the
  /// same organisation scope; a device that carried only a company would be
  /// invisible to the sole trader who bought it.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// What it is, as it will be recognised on a desk.
  brandName String
  model     String
  /// The manufacturer's serial, which is what a warranty claim needs.
  serial    String?
  /// The customer's own asset tag, where they run one.
  assetTag  String?

  status DeviceStatus @default(IN_SERVICE)

  purchasedAt      DateTime?
  warrantyStartsAt DateTime?
  /// Null means "not recorded", never "no warranty" — see the comment above.
  warrantyEndsAt   DateTime?
  warrantyNote     String?

  /// Who has it, in the customer's words. Not a User: most people holding a
  /// company laptop have no account on this site and need none.
  assignedTo String?
  department String?
  location   String?

  /// Where it came from, where that is known.
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tickets SupportTicket[]

  @@index([companyId])
  @@index([userId])
  @@index([warrantyEndsAt])
  @@index([serial])
  @@index([orderId])
}

model SupportTicket {
  id        String         @id @default(cuid())
  reference String         @unique
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Set from the raiser's company, so a colleague can pick up a ticket the
  /// person who raised it is not around to answer.
  companyId String?
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  subject   String
  category  String
  message   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  /// The device it is about, where it is about one.
  deviceId  String?
  device    Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  /// Set when somebody here first replied. What "we have not answered yet"
  /// actually means, and the only honest basis for a response-time figure.
  firstReplyAt DateTime?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  messages  TicketMessage[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([deviceId])
}

/// One message on a support ticket.
///
/// The ticket's `message` column is the first thing the customer wrote and is
/// left exactly where it is; everything after it lives here. A ticket that is
/// one field is a ticket whose conversation happened in email, which is the
/// thing customers complain about — "I sent that three days ago" with no way to
/// tell whether they did.
model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body      String
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Which side wrote it, recorded at the time rather than derived from a role
  /// that may change later.
  fromStaff Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// ------------------------------ content ------------------------------------

model Service {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  category     String
  summary      String
  heroHeadline String
  problem      String
  solution     String
  benefits     String[]
  process      Json
  technologies String[]
  displayOrder Int       @default(100)
  featured     Boolean   @default(false)
  published    Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  faqs Faq[]

  @@index([category])
  @@index([published, deletedAt])
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  body        String
  category    String
  tags        String[]
  status      PostStatus @default(DRAFT)
  readMinutes Int        @default(5)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  // Groups FAQs for a page that is not backed by a database row, e.g. the
  // "microsoft-licensing" landing page.
  topic        String?
  displayOrder Int      @default(100)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId      String?
  brand        Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
  @@index([brandId])
  @@index([serviceId])
  @@index([topic])
  // FAQs grow with the catalogue rather than with editorial effort, so their
  // search paths get the same trigram treatment as products.
  @@index([question(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([answer(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ------------------------------ operations ---------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  // Never store credentials, tokens or raw request bodies here.
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Site-wide notices shown above the header.
///
/// Scheduling is expressed as an optional window rather than a single flag so a
/// promotion can be prepared in advance and expire on its own, without anyone
/// remembering to switch it off.
/// An independently issued certification held by this company.
///
/// Structured rather than written into page copy, for one reason: certificates
/// expire. A claim of ISO 27001 compliance sitting in a paragraph of marketing
/// text stays on the page for years after the certificate lapses, and nobody
/// notices because nothing in the system knows it was a dated fact. Here the
/// expiry is a column, the renderer checks it, and a lapsed certificate stops
/// being displayed on its own.
///
/// Every field is transcribed from the certificate itself, including the number
/// and the body that issued it, so a visitor can verify the claim rather than
/// take it on trust. Nothing here may be filled in from memory or inference.
model Certification {
  id String @id @default(cuid())

  /// The standard, exactly as written on the certificate: "ISO 9001:2015".
  standard  String
  /// What the standard covers: "Quality Management System".
  title     String
  /// The certificate's own reference number.
  reference String
  /// The certification body that issued it.
  issuer    String
  /// Where a visitor can check it is still valid.
  verifyUrl String?
  /// The scope the certificate was granted for, as printed on it.
  scope     String?

  issuedAt  DateTime
  /// Past this date the certificate is not displayed. Null means no expiry
  /// is printed on it, which is unusual and worth checking before trusting.
  expiresAt DateTime?

  displayOrder Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([standard, reference])
  @@index([displayOrder])
  @@index([expiresAt])
}

model Banner {
  id           String     @id @default(cuid())
  name         String
  message      String
  href         String?
  linkLabel    String?
  tone         BannerTone @default(INFO)
  startsAt     DateTime?
  endsAt       DateTime?
  active       Boolean    @default(false)
  displayOrder Int        @default(100)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([active, startsAt, endsAt])
}

/// A CMS-managed marketing page.
///
/// The slug is the full path below the site root, so "microsoft-365/business-standard"
/// is one row rather than a nested hierarchy. An empty slug is reserved for the
/// home page, which is a Page like any other so there is only one content system
/// to maintain.
model Page {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  keywords    String[]
  status      PageStatus @default(DRAFT)
  /// Trail of { label, href? }, validated on read and write.
  breadcrumb  Json       @default("[]")
  /// Optional joins that let blocks pull live rows without duplicating them.
  brandId     String?
  brand       Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  faqTopic    String?
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sections PageSection[]

  @@index([status, deletedAt])
  @@index([brandId])
}

/// One ordered block on a page.
///
/// `data` holds the block's payload, validated by a zod schema selected on
/// `type` at both write and read. Fifteen sets of nullable typed columns would
/// be far worse to maintain, and a bad or legacy row degrades to a skipped
/// block rather than a failed page.
model PageSection {
  id           String          @id @default(cuid())
  pageId       String
  page         Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type         PageSectionType
  displayOrder Int             @default(100)
  visible      Boolean         @default(true)
  data         Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([pageId, displayOrder])
}

/// Header, footer and utility navigation.
///
/// Exactly two levels in practice: a top-level item, then either a flat list of
/// links or a set of columns. `href` is free-form because many links are
/// catalogue filters such as /products?brand=microsoft rather than routes.
model NavigationItem {
  id           String           @id @default(cuid())
  menu         NavigationMenu
  label        String
  href         String?
  description  String?
  parentId     String?
  parent       NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[] @relation("NavTree")
  displayOrder Int              @default(100)
  visible      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([menu, parentId, displayOrder])
}

/// The company's public-facing business identity, editable in the admin panel.
///
/// Exactly one row, whose id is always `singleton` — the values describe *this*
/// company, so a second row would be meaningless. `upsert` on that fixed id is
/// what creates it, which means a fresh install needs no seed for it.
///
/// Everything here was previously environment configuration and is here now
/// because it changes without the code changing: a phone number, an office
/// move, a newly appointed grievance officer. Editing those should not require
/// a rebuild and a redeploy.
///
/// Two categories deliberately did *not* move.
///
/// The trading name, legal name and tagline stay in the environment because
/// they are read at module scope by `buildMetadata`, in 46 route files, where
/// nothing can be awaited — and because renaming a company is a rebrand, not a
/// Tuesday afternoon edit.
///
/// Bank details stay in the environment because they are payment credentials.
/// They reach one outbound order email and are never read by a page, so putting
/// them behind a login that an administrator account could reach would widen
/// their exposure for no gain in convenience.
///
/// Every column is nullable, and a null falls back to its environment variable.
/// That is what lets an already-running deployment upgrade without losing a
/// single value: until someone edits a field in the panel, the environment
/// still supplies it.
/// A numbering series, and where it has got to.
///
/// One row per series — "TZ/QT/2627/" — holding the next number to hand out.
/// Incremented atomically in the same statement that reads it, so two
/// quotations raised at the same instant cannot be given the same number; see
/// `lib/document-series`.
///
/// The key is the rendered template with the counter removed, so what a series
/// resets on is decided by the template alone and there is no second setting
/// to keep in step with it.
model DocumentSeries {
  key       String   @id
  next      Int      @default(1)
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id String @id @default("singleton")

  emailSales      String?
  emailSupport    String?
  emailEnterprise String?
  phoneSales      String?
  phoneSupport    String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postcode     String?
  country      String?

  gstin        String?
  cin          String?
  supportHours String?

  /// What one US dollar / UAE dirham is worth, in paise.
  ///
  /// Set by an administrator and never guessed. There is no default and no
  /// live feed: a rate this site invented would be a price this business did
  /// not agree to, and a feed that failed would either freeze at a stale
  /// number or take the catalogue down. A currency with no rate is simply not
  /// offered, so the switcher shows only what has been priced deliberately.
  ///
  /// Paise rather than a decimal for the same reason as every other money
  /// value here: integers, and no floating point anywhere near a price.
  /// 1 USD at ₹83.50 is stored as 8350.
  usdRatePaise Int?
  aedRatePaise Int?

  /// The terms printed at the foot of every quotation email.
  ///
  /// Deliberately empty by default and never seeded with sample wording.
  /// Payment terms, validity, delivery timelines and a liability position are
  /// commercial and legal commitments this business makes to its customers;
  /// inventing plausible-looking ones and mailing them out would be worse than
  /// sending none. Until it is set, quotations link to the published terms page
  /// instead. Markdown; one point per line.
  quoteTerms String?

  /// How quotation numbers are formed, e.g. "TZ/QT/{FY}/{SEQ:4}".
  ///
  /// Blank means no series: the document prints the internal reference, which
  /// is what it did before this existed. Deliberately not defaulted to a
  /// pattern — a numbering series is a business convention, and one this
  /// application chose would collide with whatever the business already uses
  /// on the documents it has issued so far. See `lib/document-number`.
  quoteNumberFormat String?

  /// A second legal entity or overseas office, printed under the letterhead.
  ///
  /// Both or neither: a name with no address is a claim to a presence nobody
  /// can write to. Left blank on a business that trades as one entity, which
  /// is most of them.
  secondaryEntityName    String?
  secondaryEntityAddress String?

  /// Publishing a named grievance officer and their contact details is required
  /// of an online seller in India by the Consumer Protection (E-Commerce) Rules
  /// 2020. It is a statutory appointment rather than marketing copy, which is
  /// why it lives here and not in a content block anyone could edit.
  grievanceName  String?
  grievanceEmail String?
  grievancePhone String?

  updatedAt   DateTime @updatedAt
  /// The administrator who last saved. Nullable so a row written by a migration
  /// or a restore does not have to invent an author.
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Which payment gateway is configured, and its credentials.
///
/// One row, id `singleton`, like `SiteSettings` — and separate from it on
/// purpose. This holds credentials that can move money; that holds a telephone
/// number and an office address. Keeping them apart means the payment
/// credentials are not read on every page render, and a mistake in the
/// business-identity form cannot touch them.
///
/// The two secrets are encrypted at rest by `lib/secret-box.ts` and are never
/// sent back to a browser. The key id is not a secret — Razorpay Checkout needs
/// it in the page — so it is stored and displayed in the clear.
model PaymentSettings {
  id String @id @default("singleton")

  /// Off by default. Turning it on with no keys does nothing: the payment
  /// option only appears when the gateway is both enabled and configured.
  enabled Boolean @default(false)

  /// TEST or LIVE. Stored rather than inferred from the key prefix, so that
  /// pointing at live keys is a deliberate act with its own audit entry.
  mode PaymentMode @default(TEST)

  razorpayKeyId         String?
  /// AES-256-GCM, keyed from AUTH_SECRET. Never rendered.
  razorpayKeySecret     String?
  /// Also encrypted. Used to authenticate Razorpay's webhook calls, which is
  /// the only trustworthy signal that a payment was actually captured.
  razorpayWebhookSecret String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

enum PaymentMode {
  TEST
  LIVE
}

/// The outbound mail server.
///
/// Held here rather than only in environment configuration for the same reason
/// as the business identity: changing which mailbox sends the site's email is
/// an ordinary administrative act, and it should not require SSH access and a
/// redeploy. Every field falls back to its environment variable when unset, so
/// a deployment already configured through `.env` keeps working untouched until
/// somebody edits it here.
///
/// The password is encrypted at rest by `lib/secret-box.ts` and is never sent
/// back to a browser.
/// How outbound mail leaves this system.
enum MailProvider {
  /// A mail server on port 587 or 465, with a username and password.
  SMTP
  /// Microsoft Graph, over HTTPS. No password, no SMTP AUTH, and unaffected by
  /// a hosting provider blocking outbound mail ports — which most of them do.
  MICROSOFT_GRAPH
}

model MailSettings {
  id String @id @default("singleton")

  provider MailProvider @default(SMTP)

  /// Microsoft Entra application registration, used with the client-credentials
  /// flow: the site authenticates as itself rather than as a person, so there
  /// is no sign-in to keep alive and no refresh token to expire. Needs the
  /// Mail.Send *application* permission with tenant admin consent.
  graphTenantId     String?
  graphClientId     String?
  /// AES-256-GCM, keyed from AUTH_SECRET. Never rendered.
  graphClientSecret String?
  /// The mailbox to send as. The application permission grants access to every
  /// mailbox in the tenant, so this is the one place that decides which — worth
  /// restricting in Entra with an application access policy as well.
  graphSender       String?

  host   String?
  port   Int?
  /// Implicit TLS on connect (port 465). Most providers use STARTTLS on 587,
  /// where this is false.
  secure Boolean?

  username String?
  /// AES-256-GCM, keyed from AUTH_SECRET. Never rendered.
  password String?

  /// The From address. Providers generally require it to be the mailbox being
  /// signed in as, or a confirmed alias of it.
  fromAddress String?
  fromName    String?

  /// Where a copy of each new enquiry and order is sent internally.
  salesNotificationEmail String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// One attempt to pay for an order through the gateway.
///
/// A row per attempt rather than a status column on the order, because
/// abandoned and failed attempts are ordinary — a customer closes the tab, a
/// bank declines, they try again with a different card — and each one is a fact
/// worth keeping when somebody later asks why an order was not paid.
///
/// The money is recorded here, never on the request that reported it. Every
/// amount is copied from the order at the moment the attempt is created, and
/// what the gateway later says it captured is checked against it.
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider String @default("razorpay")

  /// The gateway's order id. Unique because it is what the browser callback and
  /// the webhook both use to find this row, and two rows sharing one would make
  /// that lookup ambiguous at exactly the wrong moment.
  providerOrderId String @unique

  /// The gateway's payment id, known only once a payment is attempted. Unique
  /// so that a webhook and a browser callback reporting the same capture cannot
  /// produce two captured rows.
  providerPaymentId String? @unique

  status      PaymentStatus @default(CREATED)
  amountMinor Int
  currency    String        @default("INR")

  /// Which set of keys took this payment. A test payment must never be
  /// mistaken for money, and the mode can be switched between one attempt and
  /// the next, so it is recorded per attempt rather than read back from
  /// settings.
  mode PaymentMode

  /// As reported by the gateway: card, upi, netbanking, wallet. Informational.
  method        String?
  failureReason String?

  /// Set once, when the capture is first recorded. Its presence is what makes
  /// replaying a webhook a no-op.
  capturedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

enum PaymentStatus {
  /// Gateway order created; the customer has not been charged.
  CREATED
  /// Money taken and confirmed.
  CAPTURED
  /// The gateway reported a failure, or the customer gave up.
  FAILED
  /// Returned to the customer after capture.
  REFUNDED
}

/// A content change that has been applied to this database.
///
/// The schema has `prisma migrate` for structure; this is the equivalent for
/// the rows structure holds. It exists because of one true and easily missed
/// fact: **the container seeds only a database with no pages.** That guard is
/// right — a redeploy must never overwrite copy someone edited in the admin
/// panel — and its consequence is that a release which changes seeded content
/// arrives at a live site as new code and old rows. Nothing is broken, nothing
/// logs an error, and the site simply keeps showing what it showed yesterday.
///
/// So a change to seeded content is written twice: into the seed, for databases
/// that do not exist yet, and as a content migration, for the one that is
/// already serving. Each is applied at most once and recorded here, which is
/// what lets an administrator's later edits stand: the migration that set a
/// section has already run, and will not run again to undo them.
model ContentMigration {
  /// The migration's own name, e.g. `2026-08-homepage-sections`. Chosen by
  /// hand rather than generated, because it has to be readable in a log that
  /// somebody reads while wondering why a deploy did or did not change a page.
  id String @id

  /// What it did, in the words it printed at the time. Kept so the question
  /// "did this deploy apply the homepage change?" has an answer in the
  /// database rather than in a scrollback buffer that is long gone.
  summary String

  appliedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM
//
// Everything below is internal. No customer-facing route reads any of it, and
// `scripts/verify/crm.mjs` asserts that — a deal's expected value, its stage and
// the reason a previous one was lost are the business's own commercial
// position, and none of it belongs on a page a customer can reach.
// ─────────────────────────────────────────────────────────────────────────────

/// Where a piece of business stands.
///
/// Five stages, and the number is the point. A pipeline with twelve stages is a
/// pipeline nobody keeps current, and a stage that is never the answer to
/// "where is this?" is a stage that gets set once and left. These map onto what
/// actually happens here: somebody asks, we work out what they need, we quote
/// it, they argue about it, it lands or it does not.
enum DealStage {
  /// Identified, not yet worked. The inbox of the pipeline.
  NEW
  /// Being worked out: what they need, whether it is real, who decides.
  QUALIFYING
  /// A quotation has gone out.
  QUOTED
  /// They have come back on it. Price, terms, or a competitor.
  NEGOTIATION
  WON
  LOST
}

/// How a deal came to exist.
///
/// Recorded because it is the one thing that tells the business where to spend
/// its effort, and it cannot be reconstructed later — six months on, nobody
/// remembers whether a customer found the site or was called.
enum DealSource {
  /// An enquiry submitted through the site.
  WEBSITE_ENQUIRY
  /// A call or email that arrived without an enquiry.
  DIRECT
  /// Somebody we approached.
  OUTBOUND
  /// An existing customer's renewal.
  RENEWAL
  /// Passed to us by a customer or partner.
  REFERRAL
  /// A published tender or a GeM bid.
  TENDER
  OTHER
}

/// A piece of business being pursued.
///
/// ## Why this is not an Enquiry
///
/// An enquiry is a thing a customer sent. A deal is a thing this business is
/// working on, and the two are genuinely different: a renewal has no enquiry, an
/// outbound approach has no enquiry, and one large enquiry can become three
/// deals closing in three different quarters. Folding deals into `Enquiry` would
/// mean either inventing enquiries nobody sent, or losing every piece of
/// business that did not start with a form.
///
/// The link is optional and one-way for that reason: a deal may point at the
/// enquiry it came from, and usually does.
///
/// ## Money on a deal is a forecast, not a price
///
/// `expectedValueMinor` is what somebody thinks this will be worth. It is not a
/// quotation, it is never shown to a customer, and it must not be confused with
/// the figures on `Quote` — those are an offer the business has made and stands
/// behind. Kept in minor units like every other amount in this schema.
model Deal {
  id        String     @id @default(cuid())
  reference String     @unique
  title     String
  stage     DealStage  @default(NEW)
  source    DealSource @default(DIRECT)

  /// When the stage last changed.
  ///
  /// Not derivable from `updatedAt`, which moves when somebody fixes a typo in
  /// the title. This is what "sitting in Negotiation for five weeks" is
  /// measured from, and that number is the main thing a pipeline is read for.
  stageChangedAt DateTime @default(now())

  /**
   * Who this is with.
   * `companyId` is optional so a deal can exist before the company record does
   * — the first call from a prospect is a deal, and stopping to create a
   * company row first is how a deal does not get logged at all. The contact
   * fields carry what is known in the meantime, exactly as `Enquiry` does.
   */
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactName  String?
  contactEmail String?
  contactPhone String?
  /// The organisation's name as given, for a deal with no company row yet.
  companyName  String?

  /// The member of staff responsible. A deal with no owner is nobody's job.
  ownerId String?
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// What this is expected to be worth, in minor units. A forecast — see above.
  expectedValueMinor Int    @default(0)
  currency           String @default("INR")

  /// When it is expected to close. A date, because a forecast without one
  /// cannot be summed into a quarter and is therefore not a forecast.
  expectedCloseOn DateTime?

  /// Why it was lost. Only meaningful on a LOST deal, and the service layer
  /// requires it there — "we lost it" with no reason teaches the business
  /// nothing, which is the whole point of recording losses.
  lostReason String?

  /// When it reached WON or LOST. Null while it is still open.
  closedAt DateTime?

  /// The enquiry this came from, where it came from one.
  enquiryId String?
  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  quotes     Quote[]

  @@index([stage])
  @@index([ownerId])
  @@index([companyId])
  @@index([expectedCloseOn])
  @@index([stage, expectedCloseOn])
  @@index([createdAt])
}

/// What kind of thing happened, or is due to happen.
enum ActivityKind {
  CALL
  EMAIL
  MEETING
  NOTE
  /// Something still to be done. The only kind with a due date that matters.
  TASK
  /// Written by the application rather than a person — a stage change, a
  /// quotation sent. Kept in the same timeline because a person reading a deal
  /// wants one story, not two lists to interleave by hand.
  SYSTEM
}

/// One entry in the history of a relationship.
///
/// Calls, emails, meetings, notes and follow-ups in one model rather than four.
/// They are the same shape — who, when, what was said, what happens next — and
/// splitting them would mean four queries and four joins to render the one
/// thing anybody ever wants, which is the timeline.
///
/// ## Why a task is an activity
///
/// "Call them back on Tuesday" is the same record as "called them on Tuesday",
/// a few days apart. Making tasks a separate model means a completed task has
/// to be copied into the history, and a system that copies rows between tables
/// is a system where the copy eventually stops happening.
///
/// So: `dueAt` set means it is outstanding, `completedAt` set means it is done,
/// and `occurredAt` is when it actually happened. A NOTE has only `occurredAt`.
model Activity {
  id      String       @id @default(cuid())
  kind    ActivityKind @default(NOTE)
  subject String
  body    String?

  /// When it happened. Set on the way in rather than defaulted at read time,
  /// because a call logged on Friday about a conversation on Wednesday is
  /// ordinary and the timeline must show Wednesday.
  occurredAt DateTime @default(now())

  /// When it is due, for a task. Null for anything already in the past.
  dueAt       DateTime?
  /// When it was done. Null while it is still outstanding.
  completedAt DateTime?

  /**
   * What it is about. At least one of these, enforced in the service layer —
   * an activity attached to nothing cannot be found again, which makes logging
   * it worse than not logging it.
   */
  dealId    String?
  deal      Deal?           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   CompanyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Who logged it, or who owns the follow-up.
  userId String?
  user   User?   @relation("ActivityAuthor", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([userId, dueAt])
  /// Outstanding follow-ups, oldest first. The query behind "what is overdue".
  @@index([completedAt, dueAt])
}

/// Where an event stands on its way out to the customer's own CRM.
enum CrmEventStatus {
  /// Recorded, not yet sent.
  PENDING
  /// Accepted by the endpoint.
  DELIVERED
  /// Tried and refused. `lastError` says how.
  FAILED
  /// Given up on after too many attempts, or abandoned by hand. Kept rather
  /// than deleted: a business asking "why did our CRM never see that deal"
  /// deserves an answer.
  ABANDONED
}

/// One thing that happened here, queued for the CRM this business already runs.
///
/// ## The queue exists whether or not anything is listening
///
/// Events are recorded from the moment the pipeline is used, even with no
/// endpoint configured. Two reasons, and neither is optimism: the rows are a
/// truthful log of what changed and when, useful on their own; and when an
/// endpoint is eventually configured the history is there to send rather than
/// lost. What does *not* happen without an endpoint is any delivery, and the
/// settings screen says "Not connected" rather than implying otherwise.
///
/// ## Why a table rather than an HTTP call at the point of the change
///
/// A salesperson moving a deal must not wait on somebody else's server, and
/// must not have their change fail because that server is down. So the write
/// and the send are separated: the change commits, the event is a row, and
/// delivery is somebody else's problem — retried, visible, and never able to
/// roll back the thing it is reporting.
model CrmEvent {
  id     String         @id @default(cuid())
  status CrmEventStatus @default(PENDING)

  /// What happened, as a dotted name: `deal.created`, `deal.stage_changed`.
  /// A closed vocabulary in `lib/crm/events`, not free text — the receiving
  /// system switches on it.
  kind String

  /// What it happened to, so a receiver can correlate without parsing the body.
  entityType String
  entityId   String

  /// The body, exactly as it will be sent. Frozen at the moment of the event
  /// rather than rebuilt at delivery time: an event describes what was true
  /// when it happened, and re-reading the deal an hour later would send a
  /// different story than the one that occurred.
  payload Json

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  /// The failure, in the receiver's words, truncated. Kept so a misconfigured
  /// endpoint is diagnosable from this screen rather than from a server log.
  lastError     String?
  deliveredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([entityType, entityId])
}

/// Where events go, if anywhere.
///
/// Singleton, like the other integration settings. Absent or incomplete means
/// **not connected**, and every surface says so in those words rather than
/// implying a link that does not exist.
model CrmSettings {
  id String @id @default("singleton")

  /// The HTTPS endpoint events are posted to. Null means nothing is sent.
  endpointUrl String?

  /// Shared secret for the HMAC signature on each delivery, so the receiver can
  /// tell a real event from anyone who guessed the URL.
  /// AES-256-GCM, keyed from AUTH_SECRET. Never rendered.
  signingSecret String?

  /// Off by default. Configured is not the same as wanted — a business may set
  /// the endpoint up before the far end is ready.
  enabled Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("CrmSettingsEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}
